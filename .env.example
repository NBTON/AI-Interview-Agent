# ============================================
# AI INTERVIEW PLATFORM - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and modify as needed
# NEVER commit .env to git!

# ============================================
# App Settings
# ============================================
DEBUG=true
APP_ENV=development
APP_NAME=AI Interview Agent

# ============================================
# Server Configuration
# ============================================
HOST=0.0.0.0
PORT=8000

# ============================================
# CORS (Frontend URLs)
# ============================================
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ============================================
# Backend Authentication
# ============================================
RECRUITER_EMAIL=email@example.com
RECRUITER_PASSWORD=replace_with_a_strong_password
CANDIDATE_TOKEN_SECRET=replace_with_a_long_random_secret

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Optional fallback only. OpenAI is always attempted first when OPENAI_API_KEY is set.
OPENROUTER_API_KEY=
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_KEY=your_supabase_service_role_key_here
# Direct Postgres connection string for LangGraph PostgresSaver.
# Example: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_URL=your_supabase_postgres_connection_string_here
# Alternative to SUPABASE_DB_URL: use SUPABASE_URL plus the database password from Supabase project settings.
SUPABASE_DB_PASSWORD=your_supabase_database_password_here
